# Copy this file to config/product.env on a product branch and uncomment only
# the settings that product needs.
#
# export GAR_PRODUCT_NAME=ExampleProduct
#
# Optional toolchains:
# export GAR_INSTALL_PLATFORMIO=1
# export GAR_INSTALL_ESP_IDF=1
# export GAR_ESP_IDF_VERSION=v5.3.1
#
# Optional product hooks:
# export PRODUCT_BUILD_SCRIPT=scripts/product-build.sh
# export PRODUCT_ARTIFACTS_SCRIPT=scripts/product-artifacts.sh
# export PRODUCT_CLEAN_SCRIPT=scripts/product-clean.sh
#
# Optional GAR simulation-build hook:
# Copy scripts/product-sim-build.sh.example to scripts/product-sim-build.sh,
# then implement the product command there.  GaplessAgentRuntime invokes that
# script for `gar sim build`; it is not a Makefile hook.
# export GAR_SIM_APP_DIR=sources/example-app
# export GAR_TOOLS_DIR=sources/gar-tools

# Product workspace paths created by create-product-devspace.sh.
export GAR_PRODUCT_NAME=GarStreamRx
export GAR_SIM_APP_DIR=sources/gar-stream-rx
export GAR_TOOLS_DIR=sources/gar-tools
export GAR_SIM_TARGET=luckfox-rk3506
export GAR_SIM_ARTIFACT_ROOT=artifacts/from-codespace
export GAR_SIM_ARTIFACT_DEST=/usr/local/lib/gar/apps/gar-stream-rx
export GAR_SIM_RUNTIME_BUILD_IMAGE=gar-build-env-arm64-runtime

# Physical RK3506/Buildroot artifact used by `gar target build`.
export GAR_TARGET_APP_DIR="${GAR_TARGET_APP_DIR:-sources/gar-stream-rx}"
export GAR_TARGET_ARTIFACT_ROOT="${GAR_TARGET_ARTIFACT_ROOT:-artifacts/from-codespace}"
export GAR_TARGET_ARTIFACT_DEST="${GAR_TARGET_ARTIFACT_DEST:-/opt/gar/apps/gar-stream-rx}"

# Set this in the shell or an untracked local environment file after building
# the Luckfox Lyra SDK rootfs; do not commit a machine-specific absolute path.
# export RK3506_SDK_ROOT=/opt/luckfox-lyra-sdk
