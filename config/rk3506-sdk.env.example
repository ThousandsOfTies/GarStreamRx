# Copy to config/rk3506-sdk.env and adjust for the local Luckfox SDK checkout.
# The SDK rootfs must have been built at least once so output/host and its
# target sysroot exist.
export RK3506_SDK_ROOT=/opt/luckfox-lyra-sdk

# Must match `uname -r` on the physical Lyra image. The stock SPI NAND image
# currently used by GarStreamRx reports 6.1.84.
export RK3506_TARGET_KERNEL_RELEASE=6.1.84

# Override only when the SDK uses a non-default output/configuration name.
# export RK3506_BUILDROOT_OUTPUT=/opt/luckfox-lyra-sdk/buildroot/output/rockchip_rk3506_luckfox
# export RK3506_HOST_DIR=/path/to/buildroot/output/rockchip_rk3506_luckfox/host
# export RK3506_TOOLCHAIN_BIN=/path/to/host/bin
# export RK3506_SYSROOT=/path/to/host/arm-buildroot-linux-gnueabihf/sysroot
# export RK3506_TRIPLE=arm-buildroot-linux-gnueabihf
# export RK3506_KERNEL_CROSS_COMPILE=/path/to/arm-none-linux-gnueabihf-
# export RK3506_KERNEL_HOSTCC=/usr/bin/gcc
