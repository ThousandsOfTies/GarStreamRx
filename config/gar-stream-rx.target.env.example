# Copy to config/gar-stream-rx.target.env. `gar target build` includes that
# untracked file as /etc/gar/gar-stream-rx.env in the deploy artifact.
GAR_GPIO_CHIP=/dev/gpiochip0
GAR_SPI_DEVICE=/dev/spidev0.0
GAR_SPI_MAX_HZ=10000000

# Luckfox Lyra Plus: DC/RST=RM_IO3/2, KY-040 CLK/DT/SW=RM_IO8/9/10.
GAR_LCD_DC_GPIO=3
GAR_LCD_RST_GPIO=2
GAR_ENC_CLK_GPIO=8
GAR_ENC_DT_GPIO=9
GAR_ENC_SW_GPIO=10

GAR_STREAM_DISCOVERY_PORT=5601
GAR_STREAM_RX_PORT=5600

# Usually unnecessary on one LAN. Use only when broadcast cannot reach TX.
# GAR_STREAM_DISCOVERY_PEERS=192.0.2.10
