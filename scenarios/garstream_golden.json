{
  "schema_version": 1,
  "name": "garstream-golden",
  "steps": [
    {"type": "command", "node": "tx", "via": "runtime", "action": "stop", "params": {}},
    {"type": "command", "node": "rx", "via": "runtime", "action": "stop", "params": {}},
    {"type": "command", "node": "rx", "via": "runtime", "action": "start", "params": {}},
    {"type": "command", "node": "tx", "via": "runtime", "action": "start", "params": {}},
    {"type": "observe", "node": "tx", "metric": "tx.announce", "path": "source.announce_count"},
    {"type": "assert", "metric": "tx.announce", "op": "gte", "value": 1, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.online", "path": "sources.online_count"},
    {"type": "assert", "metric": "rx.online", "op": "gte", "value": 1, "timeout_ms": 15000, "interval_ms": 500},
    {"type": "observe", "node": "tx", "metric": "tx.lease", "path": "source.lease_count"},
    {"type": "assert", "metric": "tx.lease", "op": "gte", "value": 1, "timeout_ms": 15000, "interval_ms": 500},
    {"type": "observe", "node": "tx", "metric": "tx.sent", "path": "frames.sent_count"},
    {"type": "assert", "metric": "tx.sent", "op": "gt", "value": 0, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "tx", "metric": "tx.fps", "path": "frames.fps"},
    {"type": "assert", "metric": "tx.fps", "op": "gt", "value": 0, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "tx", "metric": "tx.drop", "path": "frames.drop_count"},
    {"type": "assert", "metric": "tx.drop", "op": "gte", "value": 0},
    {"type": "observe", "node": "tx", "metric": "tx.latency", "path": "frames.latency_ms"},
    {"type": "assert", "metric": "tx.latency", "op": "gte", "value": 0, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.display", "path": "frames.display_update_count"},
    {"type": "assert", "metric": "rx.display", "op": "gt", "value": 0, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.framebuffer", "path": "frames.framebuffer_checksum"},
    {"type": "assert", "metric": "rx.framebuffer", "op": "ne", "value": "", "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.stream_display_before", "path": "frames.stream_display_update_count"},
    {"type": "assert", "metric": "rx.stream_display_before", "op": "gt", "value": 0, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.stream_framebuffer_before", "path": "frames.stream_framebuffer_checksum"},
    {"type": "assert", "metric": "rx.stream_framebuffer_before", "op": "ne", "value": "", "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.received_before", "path": "frames.received_count"},
    {"type": "assert", "metric": "rx.received_before", "op": "gt", "value": 0, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.fps", "path": "frames.fps"},
    {"type": "assert", "metric": "rx.fps", "op": "gt", "value": 0, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.drop", "path": "frames.drop_count"},
    {"type": "assert", "metric": "rx.drop", "op": "gte", "value": 0},
    {"type": "observe", "node": "rx", "metric": "rx.latency", "path": "frames.latency_ms"},
    {"type": "assert", "metric": "rx.latency", "op": "gte", "value": 0, "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.health", "path": "health.ok"},
    {"type": "assert", "metric": "rx.health", "op": "eq", "value": true},
    {"type": "command", "node": "rx", "action": "press", "params": {"device": "rotary"}},
    {"type": "command", "node": "rx", "action": "rotate", "params": {"device": "rotary", "direction": 1}},
    {"type": "observe", "node": "rx", "metric": "rx.menu_item", "path": "menu.item"},
    {"type": "assert", "metric": "rx.menu_item", "op": "eq", "value": "BRIGHTNESS"},
    {"type": "observe", "node": "rx", "metric": "rx.detents", "path": "encoder.rotate_count"},
    {"type": "assert", "metric": "rx.detents", "op": "eq", "value": 1},
    {"type": "command", "node": "rx", "action": "rotate", "params": {"device": "rotary", "direction": 1}},
    {"type": "command", "node": "rx", "action": "rotate", "params": {"device": "rotary", "direction": 1}},
    {"type": "observe", "node": "rx", "metric": "rx.exit_item", "path": "menu.item"},
    {"type": "assert", "metric": "rx.exit_item", "op": "eq", "value": "EXIT"},
    {"type": "command", "node": "rx", "action": "press", "params": {"device": "rotary"}},
    {"type": "observe", "node": "rx", "metric": "rx.mode", "path": "menu.mode"},
    {"type": "assert", "metric": "rx.mode", "op": "eq", "value": "view"},
    {"type": "command", "node": "tx", "via": "runtime", "action": "stop", "params": {}},
    {"type": "wait", "milliseconds": 8000},
    {"type": "observe", "node": "rx", "metric": "rx.offline", "path": "sources.online_count"},
    {"type": "assert", "metric": "rx.offline", "op": "eq", "value": 0, "timeout_ms": 5000, "interval_ms": 500},
    {"type": "command", "node": "tx", "via": "runtime", "action": "start", "params": {}},
    {"type": "observe", "node": "rx", "metric": "rx.reconnected", "path": "sources.online_count"},
    {"type": "assert", "metric": "rx.reconnected", "op": "gte", "value": 1, "timeout_ms": 15000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.received_after", "path": "frames.received_count"},
    {"type": "assert", "metric": "rx.received_after", "op": "gt", "value_metric": "rx.received_before", "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.stream_display_after", "path": "frames.stream_display_update_count"},
    {"type": "assert", "metric": "rx.stream_display_after", "op": "gt", "value_metric": "rx.stream_display_before", "timeout_ms": 10000, "interval_ms": 500},
    {"type": "observe", "node": "rx", "metric": "rx.stream_framebuffer_after", "path": "frames.stream_framebuffer_checksum"},
    {"type": "assert", "metric": "rx.stream_framebuffer_after", "op": "ne", "value": "", "timeout_ms": 10000, "interval_ms": 500}
  ],
  "cleanup": [
    {"type": "command", "node": "rx", "via": "runtime", "action": "start", "params": {}},
    {"type": "command", "node": "tx", "via": "runtime", "action": "start", "params": {}}
  ]
}
